<UserControl x:Class="vMixController.UTCSplashScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:vMixController"
             mc:Ignorable="d" 
             Width="400" Height="400"
             d:DesignHeight="400" d:DesignWidth="400">
    <Border BorderBrush="White" BorderThickness="2">
        <Grid>
            <Grid.Background>
                <ImageBrush ImageSource="Grid.png" TileMode="Tile" ViewportUnits="Absolute" Viewport="0 0 8 8"/>
            </Grid.Background>
            <Grid Margin="8">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="30" Foreground="White" HorizontalAlignment="Center">vMix</TextBlock>
                    <TextBlock FontSize="30" Foreground="White" HorizontalAlignment="Center">Universal Title Controller</TextBlock>
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <TextBlock TextAlignment="Right" Foreground="White" x:Name="Build">line 1<LineBreak/>
                    line 2</TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
