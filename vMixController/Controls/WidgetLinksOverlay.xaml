<UserControl x:Class="vMixController.Controls.WidgetLinksOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             Focusable="False"
             Background="Transparent">
    <Grid IsHitTestVisible="False" Focusable="False">
        <Path x:Name="PART_Path"
              Stroke="White"
              StrokeThickness="1.4"
              Fill="Transparent"
              StrokeDashArray="6,4"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              SnapsToDevicePixels="True"/>
        <Path x:Name="PART_Arrows"
              Fill="White"
              Stroke="White"
              StrokeThickness="1"
              SnapsToDevicePixels="True"/>
        <Path x:Name="PART_DevicePath"
              Stroke="Lime"
              StrokeThickness="1.4"
              Fill="Transparent"
              StrokeDashArray="6,4"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              SnapsToDevicePixels="True"/>
        <Path x:Name="PART_DeviceArrows"
              Fill="Lime"
              Stroke="Lime"
              StrokeThickness="1"
              SnapsToDevicePixels="True"/>
        <Canvas x:Name="PART_DynamicLayer"
                IsHitTestVisible="False"
                Focusable="False"/>
    </Grid>
</UserControl>