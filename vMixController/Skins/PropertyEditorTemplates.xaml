<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:widget="clr-namespace:vMixController.Widgets"
                    xmlns:prop="clr-namespace:vMixController.PropertiesControls"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:col="clr-namespace:System.Collections;assembly=System.Runtime"
                    xmlns:cls="clr-namespace:vMixController.Classes"
                    xmlns:conv="clr-namespace:vMixController.Converters"
                    xmlns:this="clr-namespace:vMixController"
                    xmlns:ctrl="clr-namespace:vMixController.Controls"
                    xmlns:wpfc="clr-namespace:NKristek.Wpf.Converters;assembly=NKristek.Wpf.Converters">
    <DataTemplate x:Key="vMixControlButtonPropEditor" DataType="{x:Type widget:vMixControlButton}">
        <StackPanel>
            <prop:FilePathControl Filter="Images|*.bmp;*.jpg;*.png;*.ico" Title="Image" Value="{Binding Image, UpdateSourceTrigger=Explicit, Mode=TwoWay}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <prop:ComboBoxControl Margin="0,0,2,0" Title="Image Type" Value="{Binding ImageMax, UpdateSourceTrigger=Explicit, Converter={conv:IntegerToButtonImageTypeConverter}}" Items="{x:Static cls:Constants.ButtonImageType}"/>
                <prop:ComboBoxControl Margin="2,0,0,0" Title="Style" Grid.Column="2" Value="{Binding Style, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Items="{x:Static cls:Constants.ButtonStyle}"/>

            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <prop:BoolControl Help="{x:Static this:Help.Button_StateDependent}" Value="{Binding IsStateDependent, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Title="State Dependent" Grouped="True" Margin="0,0,2,0"></prop:BoolControl>
                <prop:BoolControl Help="{x:Static this:Help.Button_ExecuteAfterLoad}" Grid.Column="1" Value="{Binding AutoStart, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Title="Execute After Load" Grouped="True" Margin="2,0,2,0"></prop:BoolControl>
                <prop:BoolControl  Help="{x:Static this:Help.Button_Colorize}" Grid.Column="2" Value="{Binding IsColorized, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Title="Colorize Button" Grouped="True" Margin="2,0,0,0"></prop:BoolControl>
            </Grid>
            <prop:ScriptControl Commands="{Binding Commands, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Log="{Binding Log}"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="vMixControlTextFieldPropEditor" DataType="{x:Type widget:vMixControlTextField}">
        <StackPanel>
            <prop:TitleMappingControl Titles="{Binding Paths, UpdateSourceTrigger=Explicit, Mode=TwoWay}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <prop:BoolControl Margin="0,0,2,0" Grouped="True" Value="{Binding IsTable, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Title="Table"/>
                <prop:BoolControl Margin="2,0,0,0" Grouped="True" Grid.Column="1" Value="{Binding IsEditable, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Title="Editable"/>
            </Grid>
            <prop:ComboBoxControl Title="Style" Grid.Column="2" Value="{Binding Template, UpdateSourceTrigger=Explicit, Mode=TwoWay, Converter={conv:BoolToTextOrFileConverter}}" Items="{x:Static cls:Constants.TextFieldStyle}"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="vMixControlScorePropEditor" DataType="{x:Type widget:vMixControlScore}">
        <StackPanel>
            <prop:TitleMappingControl Titles="{Binding Paths, UpdateSourceTrigger=Explicit, Mode=TwoWay}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <prop:BoolControl Margin="0,0,2,0" Grouped="True" Value="{Binding IsTable, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Title="Table"/>
                <prop:BoolControl Margin="2,0,0,0" Grouped="True" Grid.Column="1" Value="{Binding IsEditable, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Title="Editable"/>
            </Grid>
            <prop:ComboBoxControl x:Name="Style" Title="Style" Grid.Column="2" Value="{Binding Style, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Items="{x:Static cls:Constants.ScoreStyle}"/>
            <!--<CheckBox IsEnabled="{Binding Value, ElementName=Style, Converter={wpfc:ObjectToStringEqualsParameterToBoolConverter}, ConverterParameter=Custom}"/>-->
            <prop:BoolControl Title="Active Buttons" IsEnabled="{Binding Value, ElementName=Style, Converter={wpfc:ObjectToStringEqualsParameterToBoolConverter}, ConverterParameter=Custom}">
                <prop:BoolControl.Values>
                    <MultiBinding Converter="{conv:ByteToPairBoolStringConverter}" Mode="TwoWay" UpdateSourceTrigger="Explicit">
                        <Binding Path="EnabledButtons" Mode="TwoWay"/>
                        <Binding Path="Hotkey" Mode="OneWay"/>
                    </MultiBinding>
                </prop:BoolControl.Values>
            </prop:BoolControl>
            <prop:StringControl Value="{Binding FormatString, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Title="Format String"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="vMixControlListPropEditor" DataType="{x:Type widget:vMixControlList}">
        <StackPanel>
            <prop:TitleMappingControl Titles="{Binding Paths, UpdateSourceTrigger=Explicit, Mode=TwoWay}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <prop:BoolControl Margin="0,0,2,0" Grouped="True" Value="{Binding IsTable, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Title="Table"/>
                <prop:BoolControl Margin="2,0,0,0" Grouped="True" Grid.Column="1" Value="{Binding IsEditable, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Title="Editable"/>
            </Grid>
            <prop:ListControl Items="{Binding Items, UpdateSourceTrigger=Explicit, Converter={conv:StringCollectionToDummyStringPropertyCollectionConverter}, Mode=TwoWay}" Visibility="{Binding Active, ElementName=DS, Converter={wpfc:BoolToInverseVisibilityConverter}}"/>
            <prop:DataSourceControl x:Name="DS" Active="{Binding DataSource.C, UpdateSourceTrigger=Explicit, Mode=TwoWay}" DataSource="{Binding DataSource.A, UpdateSourceTrigger=Explicit, Mode=TwoWay}" DataProperty="{Binding DataSource.B, UpdateSourceTrigger=Explicit, Mode=TwoWay}"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="vMixControlExternalDataPropEditor" DataType="{x:Type widget:vMixControlExternalData}">
        <StackPanel>
            <prop:IntControl Value="{Binding Period, Mode=TwoWay, UpdateSourceTrigger=Explicit}" Title="Update Period"/>
            <prop:FilePathControl Filter="External Data|*.dll" Value="{Binding DataProviderPath, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <prop:BoolControl Value="{Binding RestartData, Mode=TwoWay, UpdateSourceTrigger=Explicit}" Title="Loop Data"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="vMixControlClockPropEditor" DataType="{x:Type widget:vMixControlClock}">
        <prop:SchedulerControl Events="{Binding Events, Mode=TwoWay, UpdateSourceTrigger=Explicit, Converter={conv:ObservableCollectionCopyConverter}}"/>
    </DataTemplate>
    <DataTemplate x:Key="vMixControlPlaylistPropEditor" DataType="{x:Type widget:vMixControlPlaylist}">
        <prop:InputSelectorControl Title="Input" Items="{Binding Inputs}" Value="{Binding InputKey, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
    </DataTemplate>
    <DataTemplate x:Key="vMixControlRegionPropEditor" DataType="{x:Type widget:vMixControlRegion}">
        <prop:StringControl Title="Info" Value="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=Explicit}" TextWrapping="Wrap" AcceptReturn="True"/>
    </DataTemplate>
    <DataTemplate x:Key="vMixControlMidiInterfacePropEditor" DataType="{x:Type widget:vMixControlMidiInterface}">
        <StackPanel>
            <!--<prop:StringControl Title="Info" Value="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=Explicit}" TextWrapping="Wrap" AcceptReturn="True"/>-->
            <prop:ComboBoxControl Title="Device" Items="{x:Static widget:vMixControlMidiInterface.MidiDevices}" Value="{Binding DeviceCaps, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            <prop:MidiMappingControl Midis="{Binding Midis, Mode=TwoWay, UpdateSourceTrigger=Explicit, Converter={conv:ObservableCollectionCopyConverter}}" LearnFunction="{Binding Learn}"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="vMixControlStreamDeckPropEditor" DataType="{x:Type widget:vMixControlStreamDeck}">
        <StackPanel>
            <prop:StreamDeckMappingControl Keys="{Binding Keys, Mode=TwoWay, UpdateSourceTrigger=Explicit, Converter={conv:ObservableCollectionCopyConverter}}" LearnFunction="{Binding Learn}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="vMixControlVolumePropEditor" DataType="{x:Type widget:vMixControlVolume}">
        <StackPanel>
            <prop:InputSelectorControl IsEnabled="{Binding Value, ElementName=TCB, Converter={wpfc:ObjectToStringEqualsParameterToBoolConverter}, ConverterParameter=Input}" Title="Input" Items="{Binding Inputs}" Value="{Binding InputKey, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <prop:ComboBoxControl x:Name="TCB" Title="Target" Value="{Binding Target, UpdateSourceTrigger=Explicit, Mode=TwoWay}">
                <prop:ComboBoxControl.Items>
                    <x:Array Type="sys:String">
                        <sys:String>Input</sys:String>
                        <sys:String>Master</sys:String>
                        <sys:String>Bus&#032;A</sys:String>
                        <sys:String>Bus&#032;B</sys:String>
                        <sys:String>Bus&#032;C</sys:String>
                        <sys:String>Bus&#032;D</sys:String>
                        <sys:String>Bus&#032;E</sys:String>
                        <sys:String>Bus&#032;F</sys:String>
                        <sys:String>Bus&#032;G</sys:String>
                    </x:Array>
                </prop:ComboBoxControl.Items>
            </prop:ComboBoxControl>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <prop:ComboBoxControl Title="Style" Value="{Binding Style, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Margin="0,0,2,0" Items="{x:Static cls:Constants.HorizontalVertical}"/>
                <prop:BoolControl Grid.Column="1" Grouped="True" Value="{Binding ShowMeters, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Title="Show Meters" Margin="2,0,2,0"/>
                <prop:BoolControl Grid.Column="2" Grouped="True" Value="{Binding ShowSlider, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Title="Show Slider" Margin="2,0,0,0"/>
            </Grid>

        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="vMixControlTBarPropEditor" DataType="{x:Type widget:vMixControlTBar}">
        <StackPanel>
            <!--<prop:StringControl Title="Info" Value="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=Explicit}" TextWrapping="Wrap" AcceptReturn="True"/>-->
            <prop:ComboBoxControl Title="Style" Value="{Binding Style, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Items="{x:Static cls:Constants.HorizontalVertical}"/>
            <prop:ComboBoxControl Title="Mode" Value="{Binding Mode, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Items="{x:Static cls:Constants.TBarMode}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="vMixControlTimerPropEditor" DataType="{x:Type widget:vMixControlTimer}">
        <StackPanel>
            <prop:TitleMappingControl Titles="{Binding Paths, UpdateSourceTrigger=Explicit, Mode=TwoWay}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <prop:BoolControl Margin="0,0,2,0" Grouped="True" Value="{Binding IsTable, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Title="Table"/>
                <prop:BoolControl Margin="2,0,0,0" Grouped="True" Grid.Column="1" Value="{Binding IsEditable, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Title="Editable"/>
            </Grid>
            <prop:StringControl Value="{Binding Format, UpdateSourceTrigger=Explicit, Mode=TwoWay}" Title="Format String"/>
            <prop:BoolControl Title="Split Text" Help="Split text by chars: if your text is 11:22, you will get 1|1|:|2|2. \nUseful for creating animated timers." Value="{Binding SplitText, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <prop:BoolControl Title="High Precision" Help="1/10 millisecond" Value="{Binding IsHighPrecision, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <prop:LabelControl Title="Events" Help="Execute ExecLink on corresponding event"/>
            <prop:StringControl Title="On Start" Value="{Binding Links[0], Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <prop:StringControl Title="On Pause" Value="{Binding Links[1], Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <prop:StringControl Title="On Stop" Value="{Binding Links[2], Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <prop:StringControl Title="On Completion" Value="{Binding Links[3], Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <prop:StringControl Title="On Tick" Value="{Binding Links[4], Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="vMixControlMultiStateEditor" DataType="{x:Type widget:vMixControlMultiState}">
        <StackPanel>
            <prop:StringControl Title="IP" Value="{Binding IP, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <prop:StringControl Title="Port" Value="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <prop:StringControl Title="Login" Value="{Binding Login, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <prop:StringControl Title="Password" Value="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>

        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="vMixControlContainerPropEditor" DataType="{x:Type widget:vMixControlContainer}">
        <StackPanel>
            <prop:FilePathControl Filter="vMix Title Controller|*.vmc" Value="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <ItemsControl ItemsSource="{Binding Controls}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="4" BorderBrush="{Binding BorderColor, Converter={conv:ColorToSolidBrushConverter}}" Padding="4" Margin="2">
                            <StackPanel>
                                <prop:LabelControl Title="{Binding Name}"/>
                                <ContentPresenter x:Name="WidgetProperties" Content="{Binding}">
                                    <ContentPresenter.ContentTemplateSelector>
                                        <ctrl:TypeTemplateSelector Suffix="PropEditor"/>
                                    </ContentPresenter.ContentTemplateSelector>
                                </ContentPresenter>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="vMixControlVariableViewerPropEditor" DataType="{x:Type widget:vMixControlVariableViewer}">
        <StackPanel>
            <prop:ComboBoxControl Title="Variable" Value="{Binding Variable, Mode=TwoWay, UpdateSourceTrigger=Explicit}" Items="{Binding VariableList}"/>
            <prop:BoolControl Title="Show Variable Name" Value="{Binding ShowVariableName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="vMixControlLabelPropEditor" DataType="{x:Type widget:vMixControlLabel}">
        <TextBlock>No Individual Properties Provided</TextBlock>
    </DataTemplate>
</ResourceDictionary>
    